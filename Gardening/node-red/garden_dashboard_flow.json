 {
  "id": "6a7264656e00000f",
  "type": "function",
  "z": "6a7264656e000001",
  "x": 380,
  "y": 160,
  "wires": [
   [
    "6a7264656e000015"
   ],
   [
    "6a7264656e000016"
   ],
   [
    "6a7264656e000017"
   ],
   [
    "6a7264656e000018"
   ],
   [
    "6a7264656e000019"
   ],
   [
    "6a7264656e00001a"
   ],
   [
    "6a7264656e00001b"
   ],
   [
    "6a7264656e00001c"
   ],
   [
    "6a7264656e00001d"
   ],
   [
    "6a7264656e00001e"
   ],
   [
    "6a7264656e00001f"
   ],
   [
    "6a7264656e000020"
   ]
  ],
  "name": "split state",
  "func": "// garden/state -> one message per widget\n// Items can be switched off on the board (MQTT panel \"Data to send\"): an unticked soil sensor is\n// null in its slot, other groups (air, pump, battery, board info) are simply missing.\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\nconst ts = Date.now();\nconst soil = d.soil || [];\nconst sA = soil[0] || {}, sB = soil[1] || {};\nconst txt = s => s.name === undefined ? '-' :\n    `${s.band_text} · F ${s.full_F}% · water at ${s.water_at}% · ` +\n    `−${s.dry_rate_pts_day} pts/day${s.rate_measured ? '' : ' (est.)'} · raw ${s.raw}`;\nconst soilChart = soil.filter(s => s).map(s => ({topic: s.name, payload: s.pct, timestamp: ts}));\nconst a = d.air || {};\nconst airChart = [];\nif (a.temp_c != null) airChart.push({topic: 'Air °C', payload: a.temp_c, timestamp: ts});\nif (a.rh_pct != null) airChart.push({topic: 'Air RH %', payload: a.rh_pct, timestamp: ts});\nconst p = d.pump;\nconst pump = !p ? 'not sent' :\n    (p.fault ? '⚠ LOCKED: ' + p.fault :\n     (p.on ? 'RUNNING' : (p.busy ? 'watching moisture' : 'ready')) +\n     ` · mode ${p.mode} · today ${p.today_s} / ${p.day_max_s} s` + (p.tank_empty ? ' · TANK EMPTY' : ''));\nconst board = `${d.time || 'clock not set'} · ${d.samples} samples averaged` +\n    (d.wifi_rssi != null ? ` · WiFi ${d.wifi_rssi} dBm` : '') +\n    (d.heap_free != null ? ` · heap ${Math.round(d.heap_free / 1024)} KB` : '') +\n    (d.battery ? ` · battery ${d.battery.v} V (${d.battery.state})` : '') +\n    (d.recording ? ` · recording ${d.recording}` : '');\n// every sensor on the board, however many are configured (Sensors panel): table + chart\nconst gs = d.sensors || {};\nconst rows = soil.filter(s => s).map(s => ({name: s.name, value: s.pct, unit: '%', info: s.band_text}));\nObject.keys(gs).forEach(k => rows.push({name: gs[k].name, value: gs[k].value, unit: gs[k].unit, info: k}));\nconst allChart = Object.keys(gs).filter(k => gs[k].value != null).map(k =>\n    ({topic: gs[k].name + (gs[k].unit ? ' (' + gs[k].unit + ')' : ''), payload: gs[k].value, timestamp: ts}));\nreturn [\n    sA.pct == null ? null : {payload: sA.pct},\n    sB.pct == null ? null : {payload: sB.pct},\n    {payload: txt(sA)},\n    {payload: txt(sB)},\n    soilChart,          // array = one message per sensor on this output\n    a.temp_c == null ? null : {payload: a.temp_c},\n    a.rh_pct == null ? null : {payload: a.rh_pct},\n    airChart,\n    {payload: pump},\n    {payload: board},\n    rows.length ? {payload: rows} : null,\n    allChart\n];",
  "outputs": 12,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": []
 },
